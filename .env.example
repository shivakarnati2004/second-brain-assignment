# Copy this file to .env.local and fill in your values

# Database - PostgreSQL connection string
# Local: postgresql://username:password@localhost:5432/second_brain
# Neon: postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/second_brain?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/second_brain

# Gemini AI API Key - Get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Next.js public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth/session
AUTH_SECRET=replace_with_long_random_secret_min_32_chars

# Public Brain API security
PUBLIC_BRAIN_API_KEY=replace_with_public_api_key
NEXT_PUBLIC_PUBLIC_BRAIN_API_KEY=replace_with_public_api_key
PUBLIC_BRAIN_ALLOWED_ORIGINS=http://localhost:3000